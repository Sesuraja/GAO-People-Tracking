{
  "entities": {
    "Alert": {
      "title": "Alert",
      "description": "System security and info alerts",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number", "description": "Unix timestamp" }
      },
      "required": ["type", "message", "timestamp"]
    },
    "Device": {
      "title": "Device",
      "description": "RFID Readers and Devices",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "zone": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "LiveTag": {
      "title": "Live Tag",
      "description": "Real-time tracking tags",
      "type": "object",
      "properties": {
        "TagID": { "type": "string" },
        "Location": { "type": "string" },
        "Timestamp": { "type": "string" },
        "dwellTime": { "type": "number" },
        "lastSeen": { "type": "string" }
      },
      "required": ["TagID", "Location", "Timestamp"]
    },
    "Setting": {
      "title": "Setting",
      "description": "App settings",
      "type": "object",
      "properties": {
        "apiUrl": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Alerts triggered by GAO tags"
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Configured reader devices"
    },
    "/live_tags/{tagId}": {
      "schema": "LiveTag",
      "description": "Currently active tags"
    },
    "/settings/{document}": {
      "schema": "Setting",
      "description": "App settings"
    }
  }
}
