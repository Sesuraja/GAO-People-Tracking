rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /live_tags/{tagId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
